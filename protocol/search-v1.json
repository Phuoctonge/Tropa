{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tropa.local/protocol/search-v1.json",
  "title": "Tropa search IPC v1",
  "description": "4-byte big-endian frame length plus UTF-8 JSON; 1..262144 payload bytes. Identity is accepted only in probe commands.",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "hello"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "probe"
            },
            "payload": {
              "$ref": "#/$defs/probe"
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "cancel"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "shutdown"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "type",
            "payload"
          ]
        }
      ]
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "hello"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "buildId": {
                  "type": "string",
                  "minLength": 1
                },
                "transports": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "wg",
                      "awg",
                      "masqueH3",
                      "masqueH2"
                    ]
                  }
                },
                "tuning": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "parameterSets": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {"$ref": "#/$defs/capabilityName"},
                      "transport": {"enum": ["wg", "awg", "masqueH3", "masqueH2"]},
                      "parameters": {"$ref": "#/$defs/parameters"}
                    },
                    "required": ["name", "transport", "parameters"]
                  }
                },
                "unavailableTuning": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {"$ref": "#/$defs/capabilityName"},
                      "reason": {"$ref": "#/$defs/capabilityName"}
                    },
                    "required": ["name", "reason"]
                  }
                }
              },
              "required": [
                "buildId",
                "transports",
                "tuning"
              ]
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "sequence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "accepted"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "sequence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "progress"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "completed": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "completed",
                "total"
              ]
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "sequence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "candidate"
            },
            "payload": {
              "$ref": "#/$defs/candidate"
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "sequence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "jobFinished"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "outcome": {
                  "enum": [
                    "completed",
                    "cancelled"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "sequence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "searchId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "error"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stage": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "stage",
                "reason",
                "retryable"
              ]
            }
          },
          "required": [
            "version",
            "searchId",
            "jobId",
            "sequence",
            "type",
            "payload"
          ]
        }
      ]
    },
    "wgIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateKey": {
          "type": "string",
          "minLength": 1
        },
        "peerPublicKey": {
          "type": "string",
          "minLength": 1
        },
        "ipv4": {
          "type": "string",
          "minLength": 1,
          "format": "ipv4"
        },
        "ipv6": {
          "type": "string"
        },
        "reserved": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "privateKey",
        "peerPublicKey",
        "ipv4",
        "reserved"
      ]
    },
    "ecIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateKeyDer": {
          "type": "string",
          "minLength": 1
        },
        "peerPublicKeyDer": {
          "type": "string",
          "minLength": 1
        },
        "ipv4": {
          "type": "string",
          "minLength": 1,
          "format": "ipv4"
        },
        "ipv6": {
          "type": "string"
        }
      },
      "required": [
        "privateKeyDer",
        "peerPublicKeyDer",
        "ipv4"
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wireGuard": {
              "$ref": "#/$defs/wgIdentity"
            }
          },
          "required": [
            "wireGuard"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "masque": {
              "$ref": "#/$defs/ecIdentity"
            }
          },
          "required": [
            "masque"
          ]
        }
      ]
    },
    "awg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "jmin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "jmax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "i1": {
          "type": "string"
        }
      },
      "required": [
        "jc",
        "jmin",
        "jmax",
        "i1"
      ]
    },
    "capabilityName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "awg": {
          "$ref": "#/$defs/awg"
        },
        "sni": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "wg",
            "awg",
            "masqueH3",
            "masqueH2"
          ]
        },
        "ipv6": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "tunnelLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "required": [
        "transport",
        "ipv6",
        "targets",
        "identity",
        "parameters",
        "timeoutMs",
        "tunnelLimit"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "enum": [
                  "wg",
                  "awg"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "wireGuard": {
                    "$ref": "#/$defs/wgIdentity"
                  }
                },
                "required": [
                  "wireGuard"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "masque": {
                    "$ref": "#/$defs/ecIdentity"
                  }
                },
                "required": [
                  "masque"
                ]
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sni": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "sni"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "awg"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "awg": {
                    "$ref": "#/$defs/awg"
                  }
                },
                "required": [
                  "awg"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "wg"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        }
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handshake": { "type": ["boolean", "null"] },
        "http": { "type": ["boolean", "null"] },
        "https": { "type": ["boolean", "null"] },
        "udp": { "type": ["boolean", "null"] }
      },
      "required": ["handshake", "http", "https", "udp"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "wg",
            "awg",
            "masqueH3",
            "masqueH2"
          ]
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "stages": {
          "$ref": "#/$defs/stages"
        },
        "endpointPingMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tunnelPingMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lossPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "jitterMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeCountry": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCountry": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "endpoint",
        "transport",
        "parameters",
        "stages",
        "endpointPingMs",
        "tunnelPingMs",
        "lossPercent",
        "jitterMs",
        "samples",
        "method",
        "node",
        "nodeCountry",
        "exitCountry"
      ]
    }
  }
}
